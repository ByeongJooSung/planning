{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "systemCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,9}$"
          },
          "parentId": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MENU",
              "PAGE",
              "POPUP",
              "LAYER",
              "TAB",
              "EXTERNAL"
            ]
          },
          "loginRequired": {
            "default": false,
            "type": "boolean"
          },
          "roles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "taskIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "change": {
            "default": "NEW",
            "type": "string",
            "enum": [
              "NEW",
              "CHANGED",
              "DELETED",
              "KEPT"
            ]
          },
          "changeReason": {
            "type": "string"
          },
          "devices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "func": {
            "type": "string"
          },
          "boardType": {
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "track": {
            "type": "object",
            "properties": {
              "design": {
                "type": "string",
                "enum": [
                  "NOT_STARTED",
                  "IN_PROGRESS",
                  "DONE",
                  "NA"
                ]
              },
              "publish": {
                "type": "string",
                "enum": [
                  "NOT_STARTED",
                  "IN_PROGRESS",
                  "DONE",
                  "NA"
                ]
              },
              "dev": {
                "type": "string",
                "enum": [
                  "NOT_STARTED",
                  "IN_PROGRESS",
                  "DONE",
                  "NA"
                ]
              }
            }
          },
          "devNeeded": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "systemCode",
          "name",
          "kind"
        ]
      }
    },
    "retiredIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channels": {
      "default": [
        {
          "id": "WEB",
          "label": "웹(PC)"
        },
        {
          "id": "MOBILE",
          "label": "모바일"
        },
        {
          "id": "TABLET",
          "label": "태블릿"
        }
      ],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    },
    "systemChannels": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "tests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "screenId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "default": "기능",
            "type": "string"
          },
          "pre": {
            "default": "",
            "type": "string"
          },
          "steps": {
            "default": "",
            "type": "string"
          },
          "expected": {
            "default": "",
            "type": "string"
          },
          "taskIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "devices": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "componentNo": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "source": {
            "default": "MANUAL",
            "type": "string",
            "enum": [
              "MANUAL",
              "DRAFT",
              "AI"
            ]
          },
          "results": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "BLOCKED",
                    "NA"
                  ]
                },
                "at": {
                  "type": "string"
                },
                "by": {
                  "default": "",
                  "type": "string"
                },
                "note": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "status",
                "at"
              ]
            }
          }
        },
        "required": [
          "id",
          "screenId",
          "title"
        ]
      }
    }
  }
}
