{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "screens": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screenId": {
            "type": "string"
          },
          "systemCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,9}$"
          },
          "title": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "enum": [
              "login",
              "dashboard",
              "main",
              "list",
              "detail",
              "form",
              "popup"
            ]
          },
          "taskIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "components": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "no": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "planner": {
                  "default": "",
                  "type": "string"
                },
                "customer": {
                  "default": "",
                  "type": "string"
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "default": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "values"
                  ]
                },
                "validation": {
                  "type": "object",
                  "properties": {
                    "required": {
                      "default": false,
                      "type": "boolean"
                    },
                    "format": {
                      "type": "string"
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "allowedChars": {
                      "type": "string"
                    },
                    "timing": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ON_INPUT",
                          "ON_BLUR",
                          "ON_SUBMIT"
                        ]
                      }
                    },
                    "messages": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "condition": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "condition",
                          "text"
                        ]
                      }
                    }
                  }
                },
                "ui": {
                  "type": "object",
                  "properties": {
                    "component": {
                      "type": "string"
                    },
                    "props": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "link": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "component"
                  ]
                }
              },
              "required": [
                "no",
                "label",
                "kind"
              ]
            }
          },
          "status": {
            "default": "DRAFT",
            "type": "string",
            "enum": [
              "DRAFT",
              "REVIEWED"
            ]
          }
        },
        "required": [
          "screenId",
          "systemCode",
          "title"
        ]
      }
    }
  }
}
