{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-\\d{3,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "FILE",
              "TEXT",
              "EMAIL",
              "URL",
              "REPOSITORY"
            ]
          },
          "title": {
            "type": "string"
          },
          "location": {
            "default": "",
            "type": "string"
          },
          "addedAt": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string"
          },
          "index": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "INDEXED",
                  "UNSUPPORTED",
                  "FAILED"
                ]
              },
              "chunks": {
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "chars": {
                "default": 0,
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "addedAt"
        ]
      }
    }
  }
}
